#!/bin/sh
# Block direct pushes to protected branches. Enforce a PR-only workflow.
#
# This hook is versioned in the repository, so it survives a fresh clone —
# but git never activates hooks from a tracked directory automatically.
# Each clone must opt in once:
#
#     git config core.hooksPath .githooks
#
# Intentional bypass: git push --no-verify
#
# GitHub branch protection enforces the same rule server-side; this hook only
# makes the failure immediate instead of a rejected push after upload.

protected="refs/heads/main refs/heads/release"

while read -r local_ref local_sha remote_ref remote_sha; do
	for p in $protected; do
		if [ "$remote_ref" = "$p" ]; then
			branch=${remote_ref#refs/heads/}
			echo "✋ Direct push to '$branch' blocked — open a Pull Request instead." >&2
			echo "   Bypass intentionally: git push --no-verify" >&2
			exit 1
		fi
	done
done

exit 0
