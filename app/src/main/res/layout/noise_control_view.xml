<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into NoiseControlView itself, which is the horizontal row: one level of nesting, not two. -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/noiseSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/noise_switch_spacing"/>

    <LinearLayout
        android:id="@+id/noiseControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/noiseLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"/>

        <SeekBar
            android:id="@+id/noiseSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>
    </LinearLayout>
</merge>
