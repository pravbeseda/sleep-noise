<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:fitsSystemWindows="true"
    android:padding="32dp">

    <!--
      The noises take whatever height the play button and the timer leave, and scroll inside it.
      Weight rather than wrap_content: the lab adds a row per experiment, and rows that outgrow the
      screen used to push the button off the bottom instead of scrolling. The picture below is
      weighted too, so what is left over is shared rather than spent on the picture first — on a
      short screen an unweighted picture keeps its full height and leaves the rows none at all. The
      4:1 split is what leaves the picture its natural size on a phone in portrait, where it is the
      narrower dimension that decides how tall it is drawn.
    -->
    <ScrollView
        android:id="@+id/noiseScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ru.pravbeseda.sleepnoise.ui.NoiseControlView
                android:id="@+id/pinkNoiseControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <ru.pravbeseda.sleepnoise.ui.NoiseControlView
                android:id="@+id/brownNoiseControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Filled in code from NOISE_LAB_CANDIDATES, so a new experiment needs no edit here. -->
            <LinearLayout
                android:id="@+id/noiseLabContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/playTimerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="64dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/playButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/play_button_background"
                android:contentDescription="@string/play_button"
                android:text=""
                android:gravity="center"
                android:padding="16dp"
                android:drawableTop="@drawable/ic_play"
                android:drawableTint="@android:color/white"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- The end inset the noise rows carry themselves, so the timer slider ends where they do. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/content_horizontal_inset">

            <ru.pravbeseda.sleepnoise.timer.TimerView
                android:id="@+id/timerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- fitCenter, so the picture scales down inside whatever share of the height it is given. -->
    <ImageView
        android:id="@+id/cats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/cats"/>

    <TextView
        android:id="@+id/version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textSize="11sp"
        android:layout_gravity="center"
        android:paddingTop="8dp"/>

</LinearLayout>
