<?xml version="1.0" encoding="utf-8"?>
<!--
  Bottom-up, and every block's height is decided rather than negotiated: the version line sits on the
  bottom, the picture takes a fixed share of the screen above it, the play button with the timer sits
  above the picture, and the noise rows take exactly the gap that leaves. No chain and no weights —
  a chain distributes leftover height, which is the wrong question on a screen that has none: on a
  short one the picture kept its full height and left the rows nothing at all.

  So the rows are a match_constraint that cannot outgrow its gap and scrolls inside it instead, and
  what makes two rows look placed rather than stranded is that they are centred in it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="32dp">

    <ScrollView
        android:id="@+id/noiseScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/screen_block_spacing"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/playTimerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- fillViewport above makes this at least as tall as the region, so the centring has room to act. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ru.pravbeseda.sleepnoise.ui.NoiseControlView
                android:id="@+id/pinkNoiseControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <ru.pravbeseda.sleepnoise.ui.NoiseControlView
                android:id="@+id/brownNoiseControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Filled in code from NOISE_LAB_CANDIDATES, so a new experiment needs no edit here. -->
            <LinearLayout
                android:id="@+id/noiseLabContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/playTimerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/screen_block_spacing"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/cats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!--
              An ImageButton rather than a Button with a compound drawable: a compound drawable is
              drawn at the icon's own 48dp and would be clipped by the smaller circle a narrow screen
              gets, while fitCenter scales it with whatever size the dimen names.
            -->
            <ImageButton
                android:id="@+id/playButton"
                android:layout_width="@dimen/play_button_size"
                android:layout_height="@dimen/play_button_size"
                android:background="@drawable/play_button_background"
                android:contentDescription="@string/play_button"
                android:padding="@dimen/play_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@android:color/white"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- The end inset the noise rows carry themselves, so the timer slider ends where they do. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/content_horizontal_inset">

            <ru.pravbeseda.sleepnoise.timer.TimerView
                android:id="@+id/timerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!--
      The box is the drawing: its height comes from the vector's own 585.62 x 170.1, so there is no
      letterbox between the picture and the version line under it. MainActivity hides it outright
      where R.bool.show_cats says the screen is too short for decoration — it is the one block here
      that can be given up whole rather than squeezed, and squeezing it is what broke the short
      screen before.
    -->
    <ImageView
        android:id="@+id/cats"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,585.62:170.1"
        android:scaleType="fitCenter"
        android:src="@drawable/cats"
        app:layout_constraintBottom_toTopOf="@id/version_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textSize="11sp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
