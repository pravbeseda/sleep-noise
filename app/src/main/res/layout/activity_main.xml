<?xml version="1.0" encoding="utf-8"?>
<!--
  One vertical chain — the noise rows, then the play button with the timer — spread between
  the top of the screen and the picture, which sits directly above the version line at the bottom.
  Spread rather than weights: the leftover height turns into equal gaps between the two, so two noise
  rows leave gaps instead of one hole above the play button, and eight rows close the gaps to nothing
  without pushing anything off screen. The picture is deliberately not a chain member — it names no
  constraint back to the play button — so the free height collects above it and never under it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="32dp">

    <ScrollView
        android:id="@+id/noiseScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/playTimerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ru.pravbeseda.sleepnoise.ui.NoiseControlView
                android:id="@+id/pinkNoiseControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <ru.pravbeseda.sleepnoise.ui.NoiseControlView
                android:id="@+id/brownNoiseControl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Filled in code from NOISE_LAB_CANDIDATES, so a new experiment needs no edit here. -->
            <LinearLayout
                android:id="@+id/noiseLabContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/playTimerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_block_spacing"
        android:layout_marginBottom="@dimen/screen_block_spacing"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/noiseScroll"
        app:layout_constraintBottom_toTopOf="@id/cats"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!--
              An ImageButton rather than a Button with a compound drawable: a compound drawable is
              drawn at the icon's own 48dp and would be clipped by the smaller circle a narrow screen
              gets, while fitCenter scales it with whatever size the dimen names.
            -->
            <ImageButton
                android:id="@+id/playButton"
                android:layout_width="@dimen/play_button_size"
                android:layout_height="@dimen/play_button_size"
                android:background="@drawable/play_button_background"
                android:contentDescription="@string/play_button"
                android:padding="@dimen/play_button_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@android:color/white"
                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- The end inset the noise rows carry themselves, so the timer slider ends where they do. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/content_horizontal_inset">

            <ru.pravbeseda.sleepnoise.timer.TimerView
                android:id="@+id/timerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!--
      Pinned above the version line and given no top constraint, so it keeps its own proportions
      (adjustViewBounds against a width the screen decides) and stays where the eye expects it.
    -->
    <ImageView
        android:id="@+id/cats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/cats"
        app:layout_constraintBottom_toTopOf="@id/version_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/version_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/version"
        android:textSize="11sp"
        android:paddingTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
