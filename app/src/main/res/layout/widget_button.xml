<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by the launcher through RemoteViews: only the views and attributes RemoteViews allows belong here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_button_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="4dp">

    <!-- android:tint, not app:tint: the launcher inflates a plain ImageView, which knows nothing of AppCompat's. -->
    <ImageView
        android:id="@+id/widget_glyph"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_button_circle"
        android:importantForAccessibility="no"
        android:padding="8dp"
        android:src="@drawable/ic_widget_play"
        android:tint="@color/purple_on_accent"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/widget_planned"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/purple_foreground_dim"
        android:textSize="11sp"
        android:visibility="gone" />

    <Chronometer
        android:id="@+id/widget_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/purple_foreground"
        android:textSize="11sp"
        android:visibility="gone" />
</LinearLayout>
