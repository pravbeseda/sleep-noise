<resources>
    <dimen name="lang_icon_size">40dp</dimen>
    <!-- Above one noise's row. Owned by NoiseControlView, so every noise is spaced the same way. -->
    <dimen name="noise_row_spacing">24dp</dimen>
    <!-- Between a noise's checkbox and the label and slider it gates. -->
    <dimen name="noise_toggle_spacing">16dp</dimen>
    <!-- The gap activity_main leaves above and below the play button with the timer. -->
    <dimen name="screen_block_spacing">24dp</dimen>
    <!-- The narrow-screen size of the round play button; values-sw320dp carries the one every ordinary phone uses. -->
    <dimen name="play_button_size">56dp</dimen>
    <!-- Leaves the icon at ~60 % of the circle, whichever of the two sizes the circle takes. -->
    <dimen name="play_button_padding">12dp</dimen>
    <!--
      Where the noise rows stop and the play button's half of the screen starts. 0.62 here: this is
      the bucket for every screen under the 500dp of height values-h500dp names, and on one of those
      the rows need most of it — at 0.42 a landscape phone cut the second slider off.
    -->
    <item name="rows_bottom_percent" format="float" type="dimen">0.62</item>
    <!-- Side inset shared by everything the noise rows and the timer put on screen, so their edges line up. -->
    <dimen name="content_horizontal_inset">32dp</dimen>
</resources>
