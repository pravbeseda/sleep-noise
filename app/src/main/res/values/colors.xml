<?xml version="1.0" encoding="utf-8"?>
<!--
  One block per theme, because both themes are dark ones: a values-night qualifier would answer for
  both of them at once, so the colours are picked by the style in themes.xml instead.
-->
<resources>
    <!-- Dark: black all the way down, with a deep plum accent and no pure white anywhere. -->
    <color name="dark_background">#000000</color>
    <color name="dark_accent">#6D4FA8</color>
    <!-- Text, icons and the cats alike, as in the purple theme: one foreground over one window. -->
    <color name="dark_foreground">#9E98AC</color>
    <color name="dark_foreground_dim">#736E80</color>
    <!-- The play triangle on the accent circle: lighter than the text, or the button reads as disabled. -->
    <color name="dark_on_accent">#D6D0E0</color>
    <!-- The unfilled half of a slider: the accent at 30 %, dim enough to read as a groove. -->
    <color name="dark_slider_track">#4D6D4FA8</color>

    <!-- Purple: the splash colour carried into the app, over a slightly darker top. -->
    <color name="purple_background_top">#25064F</color>
    <color name="purple_background_bottom">#430985</color>
    <color name="purple_action_bar">#1D0440</color>
    <color name="purple_accent">#C7A9FF</color>
    <!-- Text, icons and the cats alike: one foreground, since they all sit on the same window. -->
    <color name="purple_foreground">#EFE7FF</color>
    <!-- The play triangle sits on the accent circle, which is far too light to carry white. -->
    <color name="purple_on_accent">#25064F</color>
    <color name="purple_slider_track">#4DC7A9FF</color>
    <color name="purple_foreground_dim">#B49BDD</color>

    <color name="splash_background">#430985</color>
    <color name="credits_text_color">#DDDDDD</color>
</resources>
