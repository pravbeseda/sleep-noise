<resources>
    <style name="Theme.SleepNoise.Splash" parent="@style/Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.SleepNoise.System</item>
    </style>

    <style name="Theme.SleepNoise.System" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
    </style>

    <style name="Theme.SleepNoise.Light" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
    </style>

    <style name="Theme.SleepNoise.Dark" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorControlNormal">@color/colorControlNormal</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
    </style>

    <!-- A noise row toggles a sound, not a setting, so its checkbox wears a speaker that is struck
         through when the noise is off. The colour is baked into the two vectors, hence no tint.
         It is set on the widget rather than as the theme's checkboxStyle: a checkbox added anywhere
         else in the app should look like a checkbox. -->
    <style name="Widget.SleepNoise.NoiseToggle" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/noise_toggle_button</item>
        <item name="android:buttonTint">@null</item>
    </style>

    <style name="CreditsDialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:textColor">@color/credits_text_color</item>
    </style>
</resources>
