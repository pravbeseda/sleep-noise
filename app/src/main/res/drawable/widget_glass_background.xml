<?xml version="1.0" encoding="utf-8"?>
<!-- See-through only: a widget has no way to blur the wallpaper behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_glass_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_glass_outline" />
    <corners android:radius="26dp" />
    <size
        android:width="100dp"
        android:height="100dp" />
</shape>
