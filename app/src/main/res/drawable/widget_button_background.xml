<?xml version="1.0" encoding="utf-8"?>
<!-- The purple theme's window gradient, top to bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="@color/purple_background_top"
        android:endColor="@color/purple_background_bottom" />
    <corners android:radius="@dimen/widget_corner_radius" />
</shape>
