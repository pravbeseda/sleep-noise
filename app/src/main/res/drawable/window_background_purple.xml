<?xml version="1.0" encoding="utf-8"?>
<!-- Top to bottom, ending on the splash colour, so opening the app continues the splash screen. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/purple_background_bottom"
        android:startColor="@color/purple_background_top"
        android:type="linear"/>
</shape>
