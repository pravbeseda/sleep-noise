<?xml version="1.0" encoding="utf-8"?>
<!-- The API 31 attributes are ignored below it, where previewImage and minWidth/minHeight answer instead. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_dark_button"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:previewImage="@drawable/widget_dark_button_preview"
    android:previewLayout="@layout/widget_dark_button"
    android:resizeMode="none"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />
